{
  "name": "speech-coach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "발표 연습 코치: 연습 중 시간·속도 안내와 연습 후 검토 구간 표시",
  "scripts": {
    "start": "node --env-file-if-exists=.env local-ai/start.mjs",
    "start:web": "node server.js",
    "ai:configure": "node local-ai/configure.mjs",
    "ai:pair": "node local-ai/pair-agent.mjs",
    "start:agent": "node --env-file-if-exists=.env local-ai/agent.mjs",
    "test": "node --test",
    "test:gemini-live": "node tests/live/gemini-live-check.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@fastify/busboy": "3.2.4",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299"
  }
}
