# Node does not automatically load .env; use process environment or Node --env-file.
PORT=3000
RELEASE_ID=dev
# Optional loopback model servers. Empty = feature unavailable; no external fallback.
LOCAL_LLM_URL=
LOCAL_MODEL_NAME=speech-coach
LOCAL_AI_TIMEOUT_MS=90000
LOCAL_STT_URL=
TRANSCRIBE_TOTAL_SECONDS=3600
# Python worker settings; not read by Node.
LOCAL_STT_MODEL_DIR=
LOCAL_STT_PORT=8081
