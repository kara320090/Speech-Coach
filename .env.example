# Node does not automatically load .env; use process environment or Node --env-file.
PORT=3000
RELEASE_ID=dev
# Optional loopback model servers. Empty = feature unavailable; no external fallback.
LOCAL_LLM_URL=
LOCAL_MODEL_NAME=speech-coach
LOCAL_AI_TIMEOUT_MS=90000
LOCAL_STT_URL=
TRANSCRIBE_TOTAL_SECONDS=3600
# Coaching is always self-hosted, even if an old AI_PROVIDER=gemini value remains.
# Explicitly opted-in /api/scripts/generate and /api/coach/support use Google.
AI_PROVIDER=local
GEMINI_MODEL=gemini-3.8-flash
# Secret: set only in the server environment (Render dashboard). Never commit a real value.
GEMINI_API_KEY=
GEMINI_TIMEOUT_MS=55000
# Support dialogue only; bounded below Vercel's external proxy deadline. Cancel remains available.
SUPPORT_GEMINI_TIMEOUT_MS=105000
# In-memory call limits for remote providers (reset on restart; not a budget guarantee).
AI_MAX_REQUESTS_PER_MINUTE=10
AI_MAX_REQUESTS_PER_DAY=200
AI_MAX_REQUESTS_PER_CLIENT_PER_MINUTE=6
AI_MAX_CONCURRENT=2
# Manual live check only: GEMINI_LIVE_TEST=1 npm run test:gemini-live
GEMINI_LIVE_TEST=
# Python worker settings; not read by Node.
LOCAL_STT_MODEL_DIR=
LOCAL_STT_PORT=8081
# Public frontend/backend and self-hosted agent (public URLs, no provider keys).
AI_BACKEND_URL=https://speech-coach-2j01.onrender.com
FRONTEND_ORIGINS=https://speech-coach-public.vercel.app
